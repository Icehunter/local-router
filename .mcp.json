{
  "mcpServers": {
    "local-router": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT:-.}/dist/server.js"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT:-.}",
        "LOCAL_LLM_BASE_URL": "${LOCAL_LLM_BASE_URL:-}",
        "LOCAL_LLM_MODEL": "${LOCAL_LLM_MODEL:-}",
        "LOCAL_LLM_TOKEN_BUDGET": "${LOCAL_LLM_TOKEN_BUDGET:-}",
        "LOCAL_LLM_REQUEST_TIMEOUT_MS": "${LOCAL_LLM_REQUEST_TIMEOUT_MS:-}",
        "LOCAL_LLM_MAX_TOKENS": "${LOCAL_LLM_MAX_TOKENS:-}",
        "LOCAL_LLM_TEMPERATURE": "${LOCAL_LLM_TEMPERATURE:-}",
        "LOCAL_LLM_TOP_P": "${LOCAL_LLM_TOP_P:-}",
        "LOCAL_LLM_TOP_K": "${LOCAL_LLM_TOP_K:-}",
        "LOCAL_LLM_MIN_P": "${LOCAL_LLM_MIN_P:-}",
        "LOCAL_LLM_REPEAT_PENALTY": "${LOCAL_LLM_REPEAT_PENALTY:-}",
        "LOCAL_LLM_ENABLE_THINKING": "${LOCAL_LLM_ENABLE_THINKING:-}",
        "LOCAL_LLM_TIER": "${LOCAL_LLM_TIER:-}",
        "LOCAL_LLM_TASKS": "${LOCAL_LLM_TASKS:-}"
      }
    }
  }
}
